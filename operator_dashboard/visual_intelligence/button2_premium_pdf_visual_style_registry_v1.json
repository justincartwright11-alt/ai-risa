  "evidence_panel_tokens": {
    "required_fields": [
      "analysis_id",
      "report_version",
      "data_basis",
      "sample_size",
      "source_quality",
      "observed_vs_modelled",
      "confidence_score",
      "uncertainty_flags",
      "limitation_note",
      "operator_review_status"
    ],
    "panel_rule": "every_visual_family_requires_a_matching_evidence_panel"
  },
  "disclaimer_footer_tokens": {
    "footer_variants": [
      "tactical_non_medical",
      "projected_modelled_estimate",
      "internal_draft_only",
      "result_comparison_verified"
    ],
    "anatomical_required_wording": "TACTICAL ANALYSIS — NOT A MEDICAL DIAGNOSIS"
  },
  "page_density_rules": {
    "max_level_1_hero_visuals_per_page": 1,
    "max_level_2_analytical_visuals_per_page": 1,
    "max_level_3_evidence_panels_per_page": 3,
    "dense_master_dashboard_allowed_only_for_summary_page": true,
    "mobile_readability_required": true,
    "print_readability_required": true
  },
  "overload_prohibitions": [
    "two anatomical skeletons on every page",
    "excessive glowing effects",
    "full rainbow heat scales on non-heat-map charts",
    "dense labels around every object",
    "decorative interface elements without analytical purpose",
    "tiny text unreadable on mobile",
    "cluttered dashboards replacing clear report pages",
    "red used as a fighter identity colour when it creates severity confusion",
    "unlabeled heat colours",
    "medical-looking injury implications without tactical/non-medical disclaimer"
  ],
  "accessibility_rules": {
    "no_colour_only_meaning": true,
    "severity_requires_label_and_colour": true,
    "important_scores_require_numeric_value": true,
    "fighter_identity_requires_name_label": true,
    "callout_text_must_remain_readable": true,
    "charts_must_avoid_overflow_and_clipping": true,
    "table_numbers_must_not_sit_on_glowing_backgrounds": true
  },
  "prohibited_states": [
    "customer_release_authorized=true",
    "public_publishing_authorized=true",
    "production_launch_authorized=true",
    "automated_delivery_authorized=true",
    "learning_activation_authorized=true",
    "visual_family_id without evidence panel rules",
    "heat map without severity scale",
    "anatomical heat map without non-medical disclaimer",
    "red used as Fighter B identity where it conflicts with risk meaning",
    "unlabeled heat colours",
    "PDF visual marked delivery-ready without visual QA gate"
  ]
}